<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:VSDownloader.ViewModels" x:CompileBindings="True" MinWidth="300"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:DataType="viewModels:MessageBoxViewModel"
             x:Class="VSDownloader.Views.MessageBoxView">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <viewModels:MessageBoxViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto * Auto">
        <TextBlock Text="{Binding Path=Title}" />
        <TextBlock Text="{Binding Path=Content}" Grid.Row="1" Margin="20" />
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center">
            <Button Content="{Binding Path=OkButtonText}" Command="{Binding Path=OkCommand}" IsVisible="{Binding Path=ShowOkButton}"/>
            <Button Content="{Binding Path=CancelButtonText}" Command="{Binding Path=CancelCommand}" IsVisible="{Binding Path=ShowCancelButton}"/>
        </StackPanel>
    </Grid>
</UserControl>